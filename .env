# .env.analytics.example
# ═════════════════════════════════════════════════════════════════════════════
# Analytics Pipeline Environment Variables
# 
# SETUP INSTRUCTIONS:
#   1. Copy this file to .env
#   2. Fill in your analytics Supabase credentials
#   3. Adjust settings as needed
# ═════════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════════
#                              ANALYTICS SUPABASE PROJECT
# ══════════════════════════════════════════════════════════════════════════════

# Analytics Supabase URL (SEPARATE project from main pipeline)
# Example: https://yyyyyyyyyyyy.supabase.co
ANALYTICS_SUPABASE_URL= "https://hrfosgxnsvwwbfbzhxzm.supabase.co"

# Analytics Supabase API Key (anon/public key)
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ANALYTICS_SUPABASE_KEY= "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhyZm9zZ3huc3Z3d2JmYnpoeHptIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTYyNDg0MiwiZXhwIjoyMDk1MjAwODQyfQ.Jn7NuJABgVH0EpzmurS6KqW8tq0n71vDdq7Ncjc--oQ"


# ══════════════════════════════════════════════════════════════════════════════
#                              BINANCE API (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# Binance base URL (default uses free tier data endpoint)
# Default: https://data-api.binance.vision
# BINANCE_BASE_URL=https://data-api.binance.vision

# Request timeout in seconds
# Default: 20
# REQUEST_TIMEOUT=20


# ══════════════════════════════════════════════════════════════════════════════
#                              COIN SELECTION
# ══════════════════════════════════════════════════════════════════════════════

# Trading pairs to analyze (comma-separated, no spaces)
# IMPORTANT: Should match your main pipeline's coins for consistency
# Default: BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
ANALYTICS_COINS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT

# Add more coins:
# ANALYTICS_COINS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,MATICUSDT,LINKUSDT


# ══════════════════════════════════════════════════════════════════════════════
#                              HISTORICAL LOOKBACK
# ══════════════════════════════════════════════════════════════════════════════

# Initial backfill: How many days of history to fetch
# Recommended: 250 (8+ months of data)
# Minimum: 90 (3 months)
# Maximum: Limited by Binance data availability (~2-3 years for major pairs)
# Default: 250
ANALYTICS_HISTORICAL_DAYS=250

# Incremental updates: How many days to look back when resuming
# This is a safety buffer - pipeline fetches from last crossover forward
# Recommended: 3-7 days
# Default: 3
ANALYTICS_INCREMENTAL_DAYS=3


# ══════════════════════════════════════════════════════════════════════════════
#                              API RATE LIMITS
# ══════════════════════════════════════════════════════════════════════════════

# Maximum Binance API calls per pipeline run
# Initial backfill needs more calls (fetching months of data)
# Incremental updates use very few calls (5-10)
# Binance limit: ~1200 requests/minute (weight-based)
# Recommended: 500 for safety
# Default: 500
ANALYTICS_API_CALL_LIMIT=500


# ══════════════════════════════════════════════════════════════════════════════
#                              FILE PATHS (OPTIONAL)
# ══════════════════════════════════════════════════════════════════════════════

# Error log file location
# Default: analytics_error.log
# ANALYTICS_LOG_FILE=analytics_error.log

# State tracking file (for resume logic)
# Default: analytics_state.json
# ANALYTICS_STATE_FILE=analytics_state.json


# ══════════════════════════════════════════════════════════════════════════════
#                              NOTES
# ══════════════════════════════════════════════════════════════════════════════

# FIRST RUN:
#   python analytics_pipeline.py --initial
#   (Fetches full historical data, takes 5-15 minutes)
#
# SUBSEQUENT RUNS:
#   python analytics_pipeline.py
#   (Incremental updates, takes 30 seconds - 2 minutes)
#
# SCHEDULING:
#   Run daily via GitHub Actions or cron job
#   See README_ANALYTICS.md for details
